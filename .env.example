# Copy this file to .env and fill in the values. Never commit .env.
# This repository is public: keep real secrets out of this template.


# --- PostgreSQL (docker compose and the backend) ---
# Database user, password and name used by docker compose and the backend.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional full connection string; when set, it wins over the three values above.
DATABASE_URL=


# --- Backend server ---
# Port and host the API listens on (defaults: 3000 and 127.0.0.1).
PORT=
HOST=
# Admin frontend origin allowed to sign in and call admin routes (default: http://localhost:5173).
AUTH_TRUSTED_ORIGIN=
# Where the rate limit reads the client address (default: request, for local use):
# request = req.ip with TRUST_PROXY_HOPS; x-real-ip = Railway alone; cloudflare = Cloudflare in front
# of Railway. See docs/runbooks/deploy.md.
CLIENT_IP_SOURCE=
# Required with CLIENT_IP_SOURCE=cloudflare: at least 32 random characters, the same value the
# Cloudflare Transform Rule sends as X-Origin-Secret.
CLOUDFLARE_ORIGIN_SECRET=
# Only with CLIENT_IP_SOURCE=request: reverse proxies in front of the API, 0 to 5 (default: 0). The
# other sources refuse it, because Railway passes a client-sent X-Forwarded-For through.
TRUST_PROXY_HOPS=


# --- Public API ---
# Extra exact origins allowed on /public routes, comma-separated (default: empty).
PUBLIC_ALLOWED_ORIGINS=
# Public requests allowed per IP and route per window (default: 60).
PUBLIC_RATE_LIMIT_LIMIT=
# Length of the rate-limit window in milliseconds (default: 60000).
PUBLIC_RATE_LIMIT_TTL_MS=


# --- Mercado Pago online payments ---
# Required: the backend refuses to start when any of these is missing or invalid.
# "sandbox" (test-account credentials) or "production" (the organizer's account).
MERCADO_PAGO_MODE=
# Secret server-side access token from the Mercado Pago application.
MERCADO_PAGO_ACCESS_TOKEN=
# Secret key Mercado Pago shows when you configure webhooks; verifies notification signatures.
MERCADO_PAGO_WEBHOOK_SECRET=
# Buyer-facing frontend origin, no trailing slash (for example http://localhost:5173).
PUBLIC_APP_URL=
# Public HTTPS URL of POST /public/payments/mercado-pago/webhook (a tunnel when testing locally).
MERCADO_PAGO_NOTIFICATION_URL=
# Hours an OXXO/SPEI voucher stays payable after each checkout, from 1 to 720 (default 72, the minimum Mercado Pago recommends). The pending registration expires one day later.
PENDING_PAYMENT_HOURS=
# How often, in milliseconds, expired online registrations are voided and their Mercado Pago payments searched once: 0 (off) or 1000 to 86400000 (default 300000, every 5 minutes).
PENDING_EXPIRY_SWEEP_INTERVAL_MS=


# --- Brevo confirmation emails ---
# Required: the backend refuses to start when any of these three is missing or invalid.
# Brevo v3 API key (Brevo > SMTP & API > API Keys), not the SMTP key. Any fake value works while EMAIL_SANDBOX=true.
BREVO_API_KEY=
# "From" address buyers see; its domain must be verified in Brevo before real delivery works.
EMAIL_SENDER_ADDRESS=
# "From" display name buyers see (for example: Los más pesados).
EMAIL_SENDER_NAME=
# Optional. "true" = Brevo validates but never delivers; "false" = real delivery.
# Defaults to true, except when NODE_ENV=production. Keep it true locally.
EMAIL_SANDBOX=
# Optional. How often failed or pending emails are retried, in milliseconds (default 60000; 0 turns retries off).
EMAIL_DISPATCH_INTERVAL_MS=
