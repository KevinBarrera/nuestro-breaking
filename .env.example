# Copy this file to .env and fill in the values. Never commit .env.
# This repository is public: keep real secrets out of this template.


# --- PostgreSQL (docker compose and the backend) ---
# Database user, password and name used by docker compose and the backend.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional full connection string; when set, it wins over the three values above.
DATABASE_URL=


# --- Backend server ---
# Port and host the API listens on (defaults: 3000 and 127.0.0.1).
PORT=
HOST=
# Admin frontend origin allowed to sign in and call admin routes (default: http://localhost:5173).
AUTH_TRUSTED_ORIGIN=


# --- Public API ---
# Extra exact origins allowed on /public routes, comma-separated (default: empty).
PUBLIC_ALLOWED_ORIGINS=
# Public requests allowed per IP and route per window (default: 60).
PUBLIC_RATE_LIMIT_LIMIT=
# Length of the rate-limit window in milliseconds (default: 60000).
PUBLIC_RATE_LIMIT_TTL_MS=


# --- Mercado Pago online payments ---
# Required: the backend refuses to start when any of these is missing or invalid.
# "sandbox" (test-account credentials) or "production" (the organizer's account).
MERCADO_PAGO_MODE=
# Secret server-side access token from the Mercado Pago application.
MERCADO_PAGO_ACCESS_TOKEN=
# Secret key Mercado Pago shows when you configure webhooks; verifies notification signatures.
MERCADO_PAGO_WEBHOOK_SECRET=
# Buyer-facing frontend origin, no trailing slash (for example http://localhost:5173).
PUBLIC_APP_URL=
# Public HTTPS URL of POST /public/payments/mercado-pago/webhook (a tunnel when testing locally).
MERCADO_PAGO_NOTIFICATION_URL=
